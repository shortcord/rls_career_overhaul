    <effect id="nam_shopsigns2-effect">
      <profile_COMMON>
        <newparam sid="nam_shopsigns2_dds-surface">
          <surface type="2D">
            <init_from>nam_shopsigns2_dds</init_from>
          </surface>
        </newparam>
        <newparam sid="nam_shopsigns2_dds-sampler">
          <sampler2D>
            <source>nam_shopsigns2_dds-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="nam_shopsigns2_dds-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
