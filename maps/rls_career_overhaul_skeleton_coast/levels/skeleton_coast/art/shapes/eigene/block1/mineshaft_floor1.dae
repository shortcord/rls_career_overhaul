  <library_effects>
    <effect id="italy_terrain_dirt-effect">
      <profile_COMMON>
        <newparam sid="utah_texture_dirt_01_d_dds_001-surface">
          <surface type="2D">
            <init_from>utah_texture_dirt_01_d_dds_001</init_from>
          </surface>
        </newparam>
        <newparam sid="utah_texture_dirt_01_d_dds_001-sampler">
          <sampler2D>
            <source>utah_texture_dirt_01_d_dds_001-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="utah_texture_dirt_01_d_dds_001-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
