  <library_effects>
    <effect id="stucco1_white2-effect">
      <profile_COMMON>
        <newparam sid="stucco1_white_dds-surface">
          <surface type="2D">
            <init_from>stucco1_white_dds</init_from>
          </surface>
        </newparam>
        <newparam sid="stucco1_white_dds-sampler">
          <sampler2D>
            <source>stucco1_white_dds-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="stucco1_white_dds-sampler" texcoord="Cube_002-mesh-map-0"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
