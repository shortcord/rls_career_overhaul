            </emission>
            <diffuse>
              <texture texture="stucco1_white_dds-sampler" texcoord="Cube_274-mesh-map-0"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
