  <library_effects>
    <effect id="backdrophwybank-effect">
      <profile_COMMON>
        <newparam sid="highwaybankgravel_dds-surface">
          <surface type="2D">
            <init_from>highwaybankgravel_dds</init_from>
          </surface>
        </newparam>
        <newparam sid="highwaybankgravel_dds-sampler">
          <sampler2D>
            <source>highwaybankgravel_dds-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="highwaybankgravel_dds-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
