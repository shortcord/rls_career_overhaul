  <library_effects>
    <effect id="TOWER_VITRE-effect">
      <profile_COMMON>
        <newparam sid="tower_vitrenight_dds-surface">
          <surface type="2D">
            <init_from>tower_vitrenight_dds</init_from>
          </surface>
        </newparam>
        <newparam sid="tower_vitrenight_dds-sampler">
          <sampler2D>
